{
	"name": "simple-sftp-mac",
	"displayName": "SimpleSFTP Mac",
	"description": "为远端项目创建本地 SFTP 同步工作区，并提供批量文件上传下载与进度反馈。",
	"version": "0.2.63",
	"publisher": "simple-local",
	"extensionKind": [
		"ui"
	],
	"license": "MIT",
	"scripts": {
		"test": "node scripts/test-serial.js",
		"build": "node scripts/verify-runtime.js",
		"package": "npm run build && node scripts/package-vsix.js",
		"install:latest": "pwsh.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/install-latest.ps1"
	},
	"bin": {
		"simple-sftp-mac-api": "./bin/simple-sftp-api.js"
	},
	"files": [
		"extension.js",
		"api-server.js",
		"host-operation-lease.js",
		"progress-inactivity.js",
		"latest-snapshot-writer.js",
		"transfer-capacity.js",
		"transfer-settlement.js",
		"transfer-settlement-probe.py",
		"compression-policy.js",
		"compression-sample.py",
		"staged-tar-receive.py",
		"resource-operation-lease.js",
		"state-store.js",
		"workspace-path.js",
		"tar-writer.js",
		"bin/simple-sftp-api.js",
		"readme.md",
		"LICENSE.txt",
		"mac-paths.js",
		"mac-bootstrap.js",
		"mac-update-gate.js"
	],
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onView:simpleSftpMac.actions",
		"onCommand:simpleSftpMac.createOrOpen",
		"onCommand:simpleSftpMac.selectServer",
		"onCommand:simpleSftpMac.importSshConfig",
		"onCommand:simpleSftpMac.openSharedServerConfig",
		"onCommand:simpleSftpMac.showCurrentTarget",
		"onCommand:simpleSftpMac.syncFromRemote",
		"onCommand:simpleSftpMac.uploadWorkspace",
		"onCommand:simpleSftpMac.uploadFiles",
		"onCommand:simpleSftpMac.markHandoffReady",
		"onCommand:simpleSftpMac.configureDownloadScope"
	],
	"main": "./mac-bootstrap.js",
	"contributes": {
		"commands": [
			{
				"command": "simpleSftpMac.createOrOpen",
				"title": "SimpleSFTP：创建或打开远端项目"
			},
			{
				"command": "simpleSftpMac.syncFromRemote",
				"title": "SimpleSFTP：远端同步到本地"
			},
			{
				"command": "simpleSftpMac.uploadWorkspace",
				"title": "SimpleSFTP：上传工作区到目标"
			},
			{
				"command": "simpleSftpMac.uploadFiles",
				"title": "SimpleSFTP：上传指定文件到目标"
			},
			{
				"command": "simpleSftpMac.markHandoffReady",
				"title": "SimpleSFTP：上传并标记交接"
			},
			{
				"command": "simpleSftpMac.configureDownloadScope",
				"title": "SimpleSFTP：设置下载文件范围"
			},
			{
				"command": "simpleSftpMac.selectServer",
				"title": "SimpleSFTP：选择服务器"
			},
			{
				"command": "simpleSftpMac.importSshConfig",
				"title": "SimpleSFTP：导入 VS Code SSH 配置"
			},
			{
				"command": "simpleSftpMac.openSharedServerConfig",
				"title": "SimpleSFTP：打开共享服务器配置"
			},
			{
				"command": "simpleSftpMac.showCurrentTarget",
				"title": "SimpleSFTP：查看当前目标"
			},
			{
				"command": "simpleSftpMac.checkPreviewUpdates",
				"title": "SimpleSFTP Mac：检查 preview 配套更新"
			}
		],
		"views": {
			"explorer": [
				{
					"id": "simpleSftpMac.actions",
					"name": "SimpleSFTP"
				}
			]
		},
		"configuration": {
			"title": "SimpleSFTP",
			"properties": {
				"simpleSftpMac.workspaceHostRoot": {
					"type": "string",
					"default": "",
					"scope": "application",
					"description": "可选 Windows 宿主工作区根目录。仅用于将 Dev Container 工作区映射到 UI Extension Host；普通 Windows 工作区无需配置。"
				},
				"simpleSftpMac.workspaceContainerRoot": {
					"type": "string",
					"default": "",
					"scope": "application",
					"description": "可选 Dev Container 工作区根目录，例如 /workspaces。远程工作区上传下载必须同时配置宿主根。"
				},
				"simpleSftpMac.remoteBase": {
					"type": "string",
					"default": "",
					"description": "用于选择项目的远端根目录。"
				},
				"simpleSftpMac.localBase": {
					"type": "string",
					"default": "",
					"description": "创建同步项目时使用的本地根目录。"
				},
				"simpleSftpMac.sshHost": {
					"type": "string",
					"default": "",
					"description": "用于 SFTP 目录浏览和文件同步的 SSH host alias。"
				},
				"simpleSftpMac.execHost": {
					"type": "string",
					"default": "",
					"description": "写入 AGENTS.md 命令示例的 SSH host。"
				},
				"simpleSftpMac.userName": {
					"type": "string",
					"default": "",
					"description": "远端 SSH 用户名。"
				},
				"simpleSftpMac.sshPort": {
					"type": "number",
					"default": 22,
					"minimum": 1,
					"maximum": 65535,
					"description": "SSH 与 SFTP 命令使用的远端端口。"
				},
				"simpleSftpMac.handoffPrompt": {
					"type": "boolean",
					"default": true,
					"description": "打开由其他设备交接过的 SimpleSFTP 工作区时，提示先同步远端代码。"
				},
				"simpleSftpMac.handoffMarkerName": {
					"type": "string",
					"default": ".simple-sftp-handoff.json",
					"description": "远端交接标记文件名。"
				},
				"simpleSftpMac.uploadOnSave": {
					"type": "boolean",
					"default": true,
					"description": "保存文件时自动上传本地变更文件。"
				},
				"simpleSftpMac.writeAgentsFile": {
					"type": "boolean",
					"default": true,
					"description": "创建或更新 AGENTS.md 中由 SimpleSFTP 管理的 Codex/agent 说明块。"
				},
				"simpleSftpMac.connectTimeoutSeconds": {
					"type": "number",
					"default": 30,
					"minimum": 1,
					"maximum": 3600,
					"description": "SSH 建立连接超时秒数，防止服务器未开机或隧道不可用时上传、下载长时间挂起。"
				},
				"simpleSftpMac.uploadTimeoutSeconds": {
					"type": "number",
					"default": 600,
					"minimum": 0,
					"maximum": 86400,
					"description": "兼容旧配置；不再限制业务总时长。文件步骤连续 120 秒无真实进展才结束等待。"
				},
				"simpleSftpMac.uploadCancellable": {
					"type": "boolean",
					"default": true,
					"description": "上传和下载进度通知是否显示手动取消按钮。"
				}
			}
		}
	},
	"devDependencies": {
		"@vscode/vsce": "4.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zlinkw/SimpleSFTP-Mac.git"
	}
}
